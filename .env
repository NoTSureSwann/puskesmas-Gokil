APP_NAME="SI Puskesmas & Klinik"
APP_ENV=local
APP_KEY=base64:XEo4uzEFFMKNGFanziewuV0fpH0WNeh/WILpBhGpfRQ=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

# DATABASE UTAMA (MySQL 8)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=puskesmas_johar_baru
DB_USERNAME=root
DB_PASSWORD=

# DATABASE LOG (SQLite)
DB_CONNECTION_LOG=sqlite
DB_DATABASE_LOG=database/log_puskesmas.sqlite

# CACHE & QUEUE (Redis)
CACHE_STORE=redis
QUEUE_CONNECTION=sync
SESSION_DRIVER=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP MAIL (Ubah ke smtp dan isi credentials asli seperti Gmail App Password jika ingin email benar-benar masuk)
MAIL_MAILER=log
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=mailtrap_username
MAIL_PASSWORD=mailtrap_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=puskesmas.johar.baru@gmail.com
MAIL_FROM_NAME="Puskesmas & Klinik"

# PUSHER (Real-time WebSocket)
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=your_pusher_app_id
PUSHER_APP_KEY=your_pusher_key
PUSHER_APP_SECRET=your_pusher_secret
PUSHER_APP_CLUSTER=ap1

# LARAVEL ECHO
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_APP_NAME="${APP_NAME}"
